#!/data/data/com.termux/files/usr/bin/bash
#
# WIDGET-KNOPF: Agent starten und Oberflaeche oeffnen
#
# Ein Druck auf dem Startbildschirm macht beides: Server hochfahren und
# danach die Oberflaeche aufmachen. Kein Tippen, kein Kopieren von
# Befehlen — genau das war der Grund, warum der Agent zu selten benutzt
# wurde.
#
# Zweimal tippen startet keinen zweiten Server: der zweite Druck beendet den
# alten Server sauber und startet genau einen frischen (Verlauf bleibt erhalten).
#
# Einrichtung einmalig:  ./termux/einrichten.sh

skript="$0"
[ -L "$skript" ] && skript="$(readlink "$skript")"
HIER="$(cd "$(dirname "$skript")" && pwd)"
. "$HIER/gemeinsam.sh"

# Der Widget-Druck IST die Start-Quelle: Er killt IMMER jeden laufenden
# Server (egal wo er herkommt — Widget-Session, Hintergrund-Job, andere
# Session) und startet danach genau EINEN frischen. Frueher wurde ein
# lebender, antwortender Server als "heilig" stehengelassen; nur ein toter
# wurde gekillt. Damit konnte ein parallel gestarteter Server (z. B. von
# einem Agenten/Hintergrund-Job) das Widget blocken: "Agent laeuft bereits"
# und kein Neustart. Der Verlauf ist trotzdem sicher, weil der Server beim
# Start von der Platte laedt (chat_verlauf._lade_verlauf) und bei leerer
# Datei den letzten nicht-leeren Backup restauriert — ein Neustart ist
# verlustfrei. Deshalb: immer killen, dann genau einen starten.
# Achtung: pkill matcht auch diesen Wrapper; deshalb wird der eigene
# Shell-Prozess ausgeschlossen (grep -v).
# Exklusiver Lock (NUR fuer die Kill-/Start-Phase): verhindert, dass ZWEI
# agent-start PARALLEL killen/starten. Ohne Lock wuerde ein zweiter Aufruf den
# gerade gestarteten Server des ersten (pkill -f uvicorn) toeten -> "Killed".
# Der Lock wird nach der Start-Phase wieder geloest, damit der naechste
# BEWUSSTE Neustart via Widget wieder moeglich ist.
#
# SELBSTHEILUNG (wichtig): Wird die Widget-Session waehrend der Kill-/Start-
# Phase abgebrochen (Android killt die Session, Handy-Neustart, Strg+C), blieb
# der Lock bisher FUER IMMER liegen. Danach meldete jeder Widget-Druck nur noch
# "Ein agent-start laeuft gerade" und tat nichts -> "Agent startet nicht mehr
# neu". Deshalb schreibt der Lock jetzt die PID des Halters + Zeitstempel; ein
# Lock ohne lebenden Halter (oder aelter als 5 Minuten) gilt als verwaist und
# wird uebernommen. Zusaetzlich raeumt ein trap ihn bei Abbruch weg.
_LOCK="$PROJEKT/termux/.agent-start.lock"
_HAELT_LOCK=0
_lock_loesen() {
    [ "$_HAELT_LOCK" = "1" ] && rm -rf "$_LOCK" 2>/dev/null
    _HAELT_LOCK=0
}
trap '_lock_loesen' EXIT INT TERM
_lock_nehmen() {
    mkdir "$_LOCK" 2>/dev/null && {
        echo "$$" > "$_LOCK/pid" 2>/dev/null
        date +%s > "$_LOCK/zeit" 2>/dev/null
        _HAELT_LOCK=1
        return 0
    }
    # Lock belegt -> Halter pruefen.
    _pid="$(cat "$_LOCK/pid" 2>/dev/null || true)"
    _zeit="$(cat "$_LOCK/zeit" 2>/dev/null || true)"
    _alt=0
    [ -n "$_zeit" ] && _alt=$(( $(date +%s) - _zeit ))
    if [ -z "$_pid" ] || ! kill -0 "$_pid" 2>/dev/null || [ "$_alt" -gt 300 ]; then
        rm -rf "$_LOCK" 2>/dev/null
        if mkdir "$_LOCK" 2>/dev/null; then
            echo "$$" > "$_LOCK/pid" 2>/dev/null
            date +%s > "$_LOCK/zeit" 2>/dev/null
            _HAELT_LOCK=1
            echo "⚠️  Verwaisten Start-Lock entfernt (abgebrochener Neustart)."
            return 0
        fi
    fi
    return 1
}

_pkill_server() {
    if ! _lock_nehmen; then
        melde "⚠️  Ein agent-start laeuft gerade (Neustart laeuft). Einen Moment warten."
        exit 0
    fi

    # 1) Alle alten uvicorn-/Server-Prozesse hart stoppen.
    pkill -9 -f "uvicorn app.main:app" 2>/dev/null
    pkill -9 -f "python -m uvicorn" 2>/dev/null
    pgrep -f "uvicorn" | while read -r _pid; do
        [ "$_pid" != "$$" ] && kill -9 "$_pid" 2>/dev/null
    done

    # 2) Auch den Inbox-Daemon beenden, damit er frisch (mit aktuellem Code)
    #    startet und keine veraltete Instanz/Sperre auf die Verlaufsdatei haelt.
    pkill -9 -f "hermes_inbox_daemon.py" 2>/dev/null

    # 3) Warten, bis der Port WIRKLICH frei ist (nicht nur pausieren), damit
    #    kein "address already in use" beim frischen Start hochkommt.
    for _ in $(seq 1 15); do
        if ! pgrep -f "uvicorn" >/dev/null 2>&1; then
            break
        fi
        sleep 0.5
    done
    sleep 1
}
_pkill_server

cd "$PROJEKT" || { melde "Projektordner nicht gefunden"; exit 1; }

# ── Gemeinsame Start-Vorbereitung (10.10.2026) ──────────────────────────────
# App-Knopf und Widget machen dieselben Schritte ueber EINE Datei:
# termux/start-vorbereiten.sh (git pull, Einrichtung, pCloud-/Vorlese-Schluessel,
# Datendateien, Wissensdatei memory.db, Weckruf, Sicherung auf Auftrag,
# Postfach-Daemon). Vorher stand die Wissensdatei-Uebernahme hier im Widget allein -
# wuerde nur noch der App-Knopf benutzt, liefe sie nie. Hier OHNE --laufend:
# der Server wurde oben bereits beendet, es folgt gleich ein Start, also laeuft
# auch ein anstehender Sicherungs-Auftrag.
if [ -f "$HIER/start-vorbereiten.sh" ]; then
    bash "$HIER/start-vorbereiten.sh" "$PROJEKT" || true
else
    melde "FEHLER: termux/start-vorbereiten.sh fehlt - Uebernahmen uebersprungen."
fi

cd backend || { melde "backend/ fehlt"; exit 1; }


echo
echo "── Server startet ─────────────────────────────"
echo "Beenden: Strg+C  (Lautstaerke-hoch + C)"
echo

# Im Hintergrund, damit dieses Skript weiterlaufen und danach die
# Oberflaeche oeffnen kann. Die Ausgabe bleibt im Terminal sichtbar.
# Bind-Adresse aus der .env: HOST_BIND (Standard 0.0.0.0 fuer Heim-WLAN/PC).
#   HOST_BIND=0.0.0.0  (Standard) -> im Heim-WLAN erreichbar (PC-Zugriff, wie gehabt)
#   HOST_BIND=127.0.0.1 -> NUR lokal (Hotel-Gast-WLAN: Backend + Key nicht im Netz)
# Zu Hause braucht nichts umgestellt zu werden (Default ist 0.0.0.0).
# Der Wert wird gezielt aus der Backend-.env gelesen (nur dieser Schlüssel,
# keine anderen .env-Interna werden ausgegeben oder exportiert).
HOST_BIND="0.0.0.0"
_env_host=$(grep -E "^HOST_BIND=" .env 2>/dev/null | tail -1 | cut -d= -f2- | cut -d'#' -f1 | tr -d '[:space:]\r"')
[ -n "$_env_host" ] && HOST_BIND="$_env_host"
python -m uvicorn app.main:app --host "$HOST_BIND" --port "$PORT" &
server=$!

# Warten, bis er wirklich antwortet. Das Laden der Vektordatei dauert
# einige Sekunden; ein sofortiger Browseraufruf liefe ins Leere.
bereit=0
for _ in $(seq 1 90); do
    sleep 1
    if agent_antwortet; then bereit=1; break; fi
    # Ist der Server unterwegs gestorben, endet das Warten sofort.
    kill -0 "$server" 2>/dev/null || break
done

if [ "$bereit" = "1" ]; then
    oberflaeche_oeffnen
else
    melde "Server kam nicht hoch – Meldung steht im Terminal"
fi

# Lock nach der Start-/Kill-Phase wieder freigeben: Der Neustart ist fertig,
# ein weiterer bewusster Neustart via Widget muss wieder moeglich sein. Die
# Race (zweites parallel laufendes agent-start) ist damit nur waehrend des
# Kill/Starts geschuetzt, nicht waehrend des normalen Server-Betriebs.
_lock_loesen

# Haelt das Skript am Leben, solange der Server laeuft. Ohne das wuerde
# die Widget-Session enden und den Server mitnehmen.
wait "$server"
_code=$?
# Sitzung selbst schliessen lassen (10.10.2026). Der naechste Widget-Tipp beendet
# diesen Server mit kill -9 -> wait liefert 137, und Termux liess die alte Sitzung
# durchgestrichen mit "Process completed (code 137) - press Enter" stehen. Termux
# schliesst eine Sitzung nur bei Code 0 oder 130 von selbst
# (TermuxTerminalSessionActivityClient.onSessionFinished). Abgeloest = 0 melden;
# jeder andere Code (echter Absturz) bleibt sichtbar stehen.
if [ "$_code" = "137" ]; then
    echo "Server von einem neueren Widget-Start abgeloest - diese Sitzung schliesst sich."
    exit 0
fi
exit "$_code"
