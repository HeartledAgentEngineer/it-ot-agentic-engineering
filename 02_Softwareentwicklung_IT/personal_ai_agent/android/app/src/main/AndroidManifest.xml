<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lokaler Backend-Zugriff (127.0.0.1:8080) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Termux per Intent starten (Nutzer gewaehrt sie einmal in den App-Einstellungen). -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <!-- Bewusst KEIN RECORD_AUDIO: Mikrofon/Weckwort kommen erst in Schritt A1c. -->

    <!-- Android 11+: Paket-Sichtbarkeit, damit der Knopf "Termux oeffnen" Termux findet. -->
    <queries>
        <package android:name="com.termux" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.HeyAgent">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Eigene Adresse heyagent://start: so oeffnet das Widget (start-termux.sh) die App.
                 Termux sieht fremde Pakete nicht (Paket-Sichtbarkeit), eine Adresse loest Android
                 aber immer auf. singleTask: ein zweiter Aufruf holt die laufende App nach vorn. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="heyagent" android:host="start" />
            </intent-filter>
        </activity>
    </application>
</manifest>
