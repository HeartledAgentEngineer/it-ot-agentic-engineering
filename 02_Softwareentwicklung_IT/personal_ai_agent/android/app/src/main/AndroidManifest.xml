<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lokaler Backend-Zugriff (127.0.0.1:8080) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Termux per Intent starten (Nutzer gewaehrt sie einmal in den App-Einstellungen). -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <!-- Mikrofon fuer die Sprachaufnahme der Seite (nur eigenes Backend, siehe MikrofonRegel).
         Android fragt beim ersten Mikrofon-Tipp; MODIFY_AUDIO_SETTINGS braucht die WebView fuer
         die Aufnahme auf manchen Geraeten. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Schlaf der Uhr aus Health Connect (nur lesen, nur Schlaf). Siehe SchlafLeser. -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <!-- S13: Aufwachzeit im stuendlichen Worker lesen (nur mit Erlaubnis, sonst beim Oeffnen). -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />
    <!-- S13b: Puls der letzten Stunde, damit der Worker abends den Live-Schlaf erkennt. -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <!-- S13b: Nur "Bildschirm an/aus" (Nutzungsdatenzugriff, Nutzer erlaubt ihn in den Einstellungen). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Alltags-Pop-up "Bitte X Stunden nachtragen" (S7). Ab Android 13 fragt die App einmal,
         sobald das Alltagsprotokoll zum ersten Mal einen Stand meldet. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+: Paket-Sichtbarkeit, damit der Knopf "Termux oeffnen" Termux findet.
         Health Connect als eigene App (bis Android 13). -->
    <queries>
        <package android:name="com.termux" />
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.HeyAgent">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Eigene Adresse heyagent://start: so oeffnet das Widget (start-termux.sh) die App.
                 Termux sieht fremde Pakete nicht (Paket-Sichtbarkeit), eine Adresse loest Android
                 aber immer auf. singleTask: ein zweiter Aufruf holt die laufende App nach vorn. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="heyagent" android:host="start" />
            </intent-filter>
        </activity>

        <!-- Pflicht fuer Health Connect: Seite "Wofuer braucht Hey Agent deinen Schlaf?".
             Bis Android 13 ruft Health Connect sie ueber ACTION_SHOW_PERMISSIONS_RATIONALE auf. -->
        <activity
            android:name=".SchlafErklaerungActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Ab Android 14 zeigt das System dieselbe Seite ueber VIEW_PERMISSION_USAGE. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".SchlafErklaerungActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
