# OpenRouter API-Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-dein-key-hier

# DeepSeek Modell (OpenRouter)
LLM_MODEL=deepseek/deepseek-chat

# Server Config
HOST=0.0.0.0
PORT=8080

# ChromaDB Persist-Verzeichnis
CHROMA_PERSIST_DIR=./chroma_data

# Einbettungen fuer die Erinnerungen (Gedaechtnis). Laufen ueber OpenRouter,
# OpenAI-kompatibler Endpunkt: POST {OPENROUTER_BASE_URL}/embeddings
# Moegliche Modelle des Kontos: GET {OPENROUTER_BASE_URL}/embeddings/models
# Standard openai/text-embedding-3-small (~0,02 $/1 Mio Token).
# Das frueher geplante lokale Modell (sentence-transformers) ist entfallen:
# auf keinem der beiden Geraete installiert. Siehe
# docs/changelog-2026-09-25-gedaechtnis-qualitaet.md
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small

# System-Prompt Datei
SYSTEM_PROMPT_FILE=./system_prompt.md

# Log-Level
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────────────────
# Wissensspeicher aus den Chat-Archiven (optional)
# ─────────────────────────────────────────────────────────────────────────
# Bleiben diese Zeilen leer, laeuft der Agent wie bisher — nur ohne
# Erinnerung an die alten Gespraeche.
#
# Auf dem Handy liegen die Dateien nach dem Kopieren per USB unter
# /sdcard/Download. Termux kommt dort aber erst heran, nachdem einmal
#   termux-setup-storage
# ausgefuehrt und die Nachfrage bestaetigt wurde. Ohne das gibt es beim
# Serverstart ein "Permission denied" auf die Datenbank.
#
# Ist die Suche spuerbar traege, liegt es am Zugriff ueber /sdcard. Dann
# beide Dateien nach $HOME verschieben und die Pfade hier nachziehen.
ARCHIV_DB_PATH=/sdcard/Download/memory.db

# Ohne die Vektordatei bleibt es bei der Volltextsuche: Die findet Woerter
# und Eigennamen, aber nichts Umschriebenes.
ARCHIV_VEKTOR_PATH=/sdcard/Download/memory.vektoren.f32

# Nur fuer die semantische Suche im ARCHIV noetig: Die Chunks sind laengst
# gerechnet, gebraucht wird ein Vektor je Frage. Ohne Schluessel laeuft der
# Volltext weiter.
# Hinweis (25.09.2026): Das GEDAECHTNIS (Erinnerungen) braucht diesen
# Schluessel NICHT mehr — es bettet ueber OpenRouter ein
# (siehe OPENROUTER_EMBED_MODEL oben).
#
# Datenschutz: Dabei verlaesst die *Frage* das Geraet (an Mistral), nicht
# der gefundene Gespraechsinhalt. Mistral ohne ZDR haelt Anfragen 30
# rollierende Tage vor.
MISTRAL_API_KEY=

# Wie viele Archiv-Treffer hoechstens in den Prompt wandern.
ARCHIV_TOP_K=5

# ─────────────────────────────────────────────────────────────────────────
# Track C — Uebergabe an lokalen Hermes (Blauplan-Option, optional)
# ─────────────────────────────────────────────────────────────────────────
# Track C (lokaler Hermes) laeuft NUR, wenn die Kommandos `hermes` UND `tmux`
# im PATH liegen (siehe backend/app/services/hermes_local.py:267 ist_verfuegbar).
# Fehlt eines davon, ist Track C nicht verfuegbar.
#
# Die drei Werte unten sind OPTIONAL — leer lassen ist zulaessig:
#   * ohne HERMES_LOCAL_SESSION startet je Auftrag eine NEUE tmux-Session
#     (chat.py: bestehende_session=None)
#   * ohne HERMES_LOCAL_KANAL wird der tmux-Weg genutzt (Default)
#   * ohne HERMES_LOCAL_MODEL bleibt es beim Hermes-Standard (kein -m-Flag)

# Name der tmux-Session, in der der lokale Hermes laeuft (Track C).
# Gesetzt  -> der Auftrag dockt an DIESE laufende Session an (geteilter Kontext).
# Leer     -> je Auftrag startet eine neue Session.
HERMES_LOCAL_SESSION=hermes

# Weg, ueber den ein Auftrag an den lokalen Hermes geht:
#   tmux  = Auftrag wird in die tmux-Session getippt (Standard)
#   query = Zweitweg, fragt die Hermes-CLI direkt ab
HERMES_LOCAL_KANAL=tmux

# Modell, mit dem der lokale Hermes den Auftrag bearbeitet (Name wie in der
# lokalen Hermes-Konfiguration). Ohne Wert laeuft der Job nicht.
HERMES_LOCAL_MODEL=local-model