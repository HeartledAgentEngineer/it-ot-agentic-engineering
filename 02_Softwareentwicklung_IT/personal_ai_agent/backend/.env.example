# OpenRouter API-Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-dein-key-hier

# DeepSeek Modell (OpenRouter)
LLM_MODEL=deepseek/deepseek-chat

# Server Config
HOST=0.0.0.0
PORT=8080

# ChromaDB Persist-Verzeichnis
CHROMA_PERSIST_DIR=./chroma_data

# Embedding-Modell (lokal)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# System-Prompt Datei
SYSTEM_PROMPT_FILE=./system_prompt.md

# Log-Level
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────────────────
# Wissensspeicher aus den Chat-Archiven (optional)
# ─────────────────────────────────────────────────────────────────────────
# Bleiben diese Zeilen leer, laeuft der Agent wie bisher — nur ohne
# Erinnerung an die alten Gespraeche.
#
# Auf dem Handy liegen die Dateien nach dem Kopieren per USB unter
# /sdcard/Download. Termux kommt dort aber erst heran, nachdem einmal
#   termux-setup-storage
# ausgefuehrt und die Nachfrage bestaetigt wurde. Ohne das gibt es beim
# Serverstart ein "Permission denied" auf die Datenbank.
#
# Ist die Suche spuerbar traege, liegt es am Zugriff ueber /sdcard. Dann
# beide Dateien nach $HOME verschieben und die Pfade hier nachziehen.
ARCHIV_DB_PATH=/sdcard/Download/memory.db

# Ohne die Vektordatei bleibt es bei der Volltextsuche: Die findet Woerter
# und Eigennamen, aber nichts Umschriebenes.
ARCHIV_VEKTOR_PATH=/sdcard/Download/memory.vektoren.f32

# Nur fuer die semantische Suche noetig: Die Chunks sind laengst gerechnet,
# gebraucht wird ein Vektor je Frage. Ohne Schluessel laeuft der Volltext
# weiter.
#
# Datenschutz: Dabei verlaesst die *Frage* das Geraet (an Mistral), nicht
# der gefundene Gespraechsinhalt. Mistral ohne ZDR haelt Anfragen 30
# rollierende Tage vor.
MISTRAL_API_KEY=

# Wie viele Archiv-Treffer hoechstens in den Prompt wandern.
ARCHIV_TOP_K=5