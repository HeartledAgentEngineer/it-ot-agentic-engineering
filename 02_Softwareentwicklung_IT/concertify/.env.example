# Spotify API — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Ticketmaster Discovery API — https://developer.ticketmaster.com
# Kostenlos: "GET YOUR API KEY" klicken, nur E-Mail + Passwort nötig
# Den "Consumer Key" hier eintragen (optional, aber empfohlen):
TICKETMASTER_API_KEY=your_consumer_key_here

# Setlist.fm API — https://www.setlist.fm/api/apikey.xml
# Kostenlos: einloggen, API Key kopieren (kein Kreditkarte nötig)
# Ermöglicht: meistgespielte Live-Songs + neue Bangers pro Künstler
SETLISTFM_API_KEY=your_setlistfm_api_key_here

# Playlist settings (optional)
PLAYLIST_NAME=Concert Ready 2026
HAMBURG_RADIUS_KM=50
TRACK_LIMIT_PER_ARTIST=10

# Serper.dev — Google Search API (Fallback wenn Tavily-Credits leer)
# Kostenlos: serper.dev → "Get Started Free" → API Key kopieren
# 2.500 Gratis-Suchen/Monat, danach $0.001/Suche
SERPER_API_KEY=your_serper_api_key_here

# Rock im Park scraper (optional override)
# ROCK_IM_PARK_LINEUP_URL=https://www.rock-im-park.com/lineup
